# Server Port (AI Studio requires port 3000)
PORT=3000
NODE_ENV=development

# Optional client API override (empty defaults to same-origin / relative /api/*)
VITE_API_URL=

# PostgreSQL Database Configuration (Managed via pgAdmin 4)
# Either provide DATABASE_URL or the individual PG* parameters:
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=diet_db
PGUSER=postgres
PGPASSWORD=divya

# Or full connection string:
DATABASE_URL=postgresql://postgres:divya@127.0.0.1:5432/diet_db
